generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String?   @unique
  password      String?
  phone         String    @unique
  phoneVerified Boolean   @default(false)
  upiId         String?
  language      String    @default("en")
  proUntil      DateTime?
  roleId        String?
  role          Role?     @relation(fields: [roleId], references: [id])

  // ✅ Back-relations
  groups        Group[]        @relation("UserGroups")
  ownedBishis   Bishi[]        @relation("UserOwnedBishis")
  transactions  Transaction[]
  notifications Notification[]
  messages      Message[]
  membership    Membership[]
  contributions Contribution[]

  created_by    String?
  created_date  DateTime @default(now())
  modified_by   String?
  modified_date DateTime @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  users       User[]
  permissions RolePermission[]

  description String?
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId]) // prevent duplicates
}

model Group {
  id                  String         @id @default(uuid())
  name                String
  users               User[]         @relation("UserGroups")
  bishis              Bishi[]
  Message             Message[]
  membership          Membership[]
  contributions       Contribution[]
  cycleMonths         Int            @default(10)
  monthlyContribution Float          @default(0)
  status              String         @default("OPEN") // "BIDDING" | "OPEN" | "CLOSED"
  nextBidRound        Int?
  nextBidAt           DateTime?

  created_by    String?
  created_date  DateTime @default(now())
  modified_by   String?
  modified_date DateTime @updatedAt
}

model Bishi {
  id           String        @id @default(uuid())
  title        String
  description  String?
  groupId      String
  group        Group         @relation(fields: [groupId], references: [id])
  ownerId      String
  owner        User          @relation("UserOwnedBishis", fields: [ownerId], references: [id])
  transactions Transaction[]

  created_by    String?
  created_date  DateTime @default(now())
  modified_by   String?
  modified_date DateTime @updatedAt
}

model Transaction {
  id      String @id @default(uuid())
  amount  Float
  bishiId String
  bishi   Bishi  @relation(fields: [bishiId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  created_by    String?
  created_date  DateTime @default(now())
  modified_by   String?
  modified_date DateTime @updatedAt
}

model Notification {
  id        String  @id @default(uuid())
  message   String
  title     String?
  type      String? // "ROUND_OPEN" | "MEMBER_JOINED" | "WINNER_CONFIRMED" | "GROUP_CREATED"
  groupName String?
  read      Boolean @default(false)
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  created_by    String?
  created_date  DateTime @default(now())
  modified_by   String?
  modified_date DateTime @updatedAt
}

model Message {
  id      String @id @default(uuid())
  content String
  groupId String
  group   Group  @relation(fields: [groupId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  created_by    String?
  created_date  DateTime @default(now())
  modified_by   String?
  modified_date DateTime @updatedAt
}

model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model AuditLog {
  id          String @id @default(uuid())
  action      String
  entity      String
  entityId    String
  performedBy String

  created_by    String?
  created_date  DateTime @default(now())
  modified_by   String?
  modified_date DateTime @updatedAt
}

model Membership {
  id      String @id @default(uuid())
  userId  String
  groupId String

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  role   String? // e.g., "member", "admin" if you want roles
  status String? // e.g., "pending", "accepted"

  created_by    String?
  created_date  DateTime @default(now())
  modified_by   String?
  modified_date DateTime @updatedAt
}

// Monthly dues owed by a member to a group for one period (for example "2026-11").
// Admins mark a due as PAID when the member settles it in cash or by direct UPI.
model Contribution {
  id         String    @id @default(uuid())
  groupId    String
  group      Group     @relation(fields: [groupId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  period     String // "YYYY-MM"
  amount     Float
  status     String    @default("PENDING") // "PENDING" | "PAID"
  method     String? // "CASH" | "UPI" (set when marked paid)
  paidAt     DateTime?
  markedById String? // admin who recorded the payment

  created_date  DateTime @default(now())
  modified_date DateTime @updatedAt

  @@unique([groupId, userId, period])
}
